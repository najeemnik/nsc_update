{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:host": "vite build && rm -rf host_upload && mkdir -p host_upload && cp -r dist/* host_upload/ && cp -r api host_upload/ && cp -r database host_upload/",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js host_upload",
    "lint": "tsc --noEmit",
    "verify:journal": "esbuild scripts/verify-journal.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/verify-journal.cjs --log-level=error && node node_modules/.cache/verify-journal.cjs",
    "test:accounting": "esbuild scripts/verify-accounting-edges.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/verify-edges.cjs --log-level=error && node node_modules/.cache/verify-edges.cjs",
    "test:offline": "esbuild scripts/verify-offline-queue.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/verify-offline.cjs --log-level=error && node node_modules/.cache/verify-offline.cjs",
    "test:notifications": "esbuild scripts/verify-notifications.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/verify-notif.cjs --log-level=error && node node_modules/.cache/verify-notif.cjs",
    "test:budget": "esbuild scripts/verify-budget-sheet.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/verify-budget.cjs --log-level=error && node node_modules/.cache/verify-budget.cjs",
    "test:coa": "esbuild scripts/verify-coa-admin.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/verify-coa.cjs --log-level=error && node node_modules/.cache/verify-coa.cjs",
    "test:permissions": "esbuild scripts/verify-permissions.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/verify-perm.cjs --log-level=error && node node_modules/.cache/verify-perm.cjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase": "^12.19.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0"
  }
}
