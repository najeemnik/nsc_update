# NIK SMART COUNT — environment variables (copy to .env and adjust)
# Frontend: Vite reads VITE_* at BUILD time. Backend (PHP): reads plain names at RUNTIME.

# --- Frontend ---
# PHP API base URL. Same-domain deploy (public_html + public_html/api): leave default.
VITE_API_URL=/api
# One-click demo logins on the login screen. Set to 'false' on the production host.
VITE_SHOW_DEMO_LOGINS=true

# --- Backend (cPanel -> Environment Variables, or api/config.php defaults) ---
# MySQL connection (keep test and production databases separate!)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=shahhost_nsc_db
DB_USER=shahhost_nsc_user
DB_PASS=change_me_strong_password
# Comma-separated CORS origins. Empty = fail-closed (same-origin only).
ALLOWED_ORIGINS=
# Optional override for the JWT signing key (auto-generated per install if empty).
JWT_SECRET=
