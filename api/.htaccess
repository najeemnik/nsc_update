# =====================================================================
# NSC API Security & Apache Routing Configuration
# Protection against unauthorized access, directory browsing & exploits
# =====================================================================

Options -Indexes
ServerSignature Off

# جلوگیری از مشاهده فایل‌های پیکربندی و دیتابیس
<FilesMatch "\.(sql|env|log|ini|json|git|lock)$">
    Require all denied
</FilesMatch>

# تنظیمات کاراکتر انکودینگ
AddDefaultCharset UTF-8

# هدرهای امنیتی
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
