# NSC Uploads Protection — no script execution, no listing (§2.5)
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .phar .cgi .pl .py .sh
<FilesMatch "\.(php|phtml|phar|cgi|pl|py|sh|exe|dll)$">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
